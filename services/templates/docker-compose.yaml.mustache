services:

  gateway:
    build:
      context: "./{{CRUPEST_DENO_DIR}}"
      dockerfile: Dockerfile
      target: gateway
      additional_contexts:
        www: "./{{CRUPEST_WWW_DIR}}"
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    env_file:
      - "./{{CRUPEST_GENERATED_DIR}}/envs/gateway.env"
      - "./{{CRUPEST_GENERATED_DIR}}/envs/mail-server-common.env"
    volumes:
      - "./{{CRUPEST_DATA_GATEWAY_DIR}}:/data"
      - "./{{CRUPEST_DATA_CERTBOT_DIR}}/certs:/etc/letsencrypt"
      - "./{{CRUPEST_DATA_CERTBOT_DIR}}/data:/var/lib/letsencrypt"
      - "./{{CRUPEST_DATA_CERTBOT_DIR}}/webroot:/var/www/certbot"
      - "./{{CRUPEST_STATE_GATEWAY_DIR}}:/app/state"
    networks:
      default:
        ipv4_address: "172.21.5.2"
    restart: "on-failure:3"

  mail-server:
    build:
      context: "./{{CRUPEST_DENO_DIR}}"
      dockerfile: Dockerfile
      target: mail-server
      additional_contexts:
        www: "./{{CRUPEST_WWW_DIR}}"
    container_name: mail-server
    hostname: mail
    domainname: "{{CRUPEST_DOMAIN}}"
    env_file:
      - "./{{CRUPEST_GENERATED_DIR}}/envs/mail-server-common.env"
      - "./{{CRUPEST_GENERATED_DIR}}/envs/mail-server.env"
    ports:
      - "25:25" # SMTP (inbound)
      - "143:143" # IMAP4 (explicit TLS => STARTTLS)
      - "993:993" # IMAP4 (implicit TLS)
      - "587:587" # ESMTP (explicit TLS => STARTTLS)
      - "465:465" # ESMTP (implicit TLS)
      - "4190:4190" # manage sieve protocol
    volumes:
      - "./{{CRUPEST_DATA_MAIL_SERVER_DIR}}:/data"
      - "./{{CRUPEST_SSL_FULLCHAIN_FILE}}:/etc/ssl/mail/tls.crt:ro"
      - "./{{CRUPEST_SSL_PRIVATE_KEY_FILE}}:/etc/ssl/mail/tls.key:ro"
      - "/etc/localtime:/etc/localtime:ro"
    networks:
      default:
        ipv4_address: "172.21.5.3"
    restart: "on-failure:3"
    stop_grace_period: 1m

  git-server:
    build:
      context: "./{{CRUPEST_DOCKER_DIR}}/git-server"
      dockerfile: Dockerfile
    hostname: git-server
    environment:
      - "CRUPEST_ROOT_URL={{CRUPEST_ROOT_URL}}"
    volumes:
      - "./{{CRUPEST_DATA_GIT_DIR}}:/git"
    networks:
      default:
        ipv4_address: "172.21.5.4"
    mem_limit: 500mb
    restart: on-failure:3

  roundcubemail:
    build:
        context: "./{{CRUPEST_DOCKER_DIR}}/roundcube"
        dockerfile: Dockerfile
    hostname: roundcubemail
    env_file:
      - "./{{CRUPEST_GENERATED_DIR}}/envs/roundcubemail.env"
    volumes:
      - "./{{CRUPEST_DATA_SECRET_DIR}}/gnupg:/var/roundcube/enigma"
      - "./{{CRUPEST_DATA_ROUNDCUBE_DIR}}/db:/var/roundcube/db"
      - "roundcubemail-html:/var/www/html"
      - "roundcubemail-temp:/tmp/roundcube-temp"
    networks:
      default:
        ipv4_address: "172.21.5.5"
    restart: on-failure:3

  auto-backup:
    build:
      context: "./{{CRUPEST_DOCKER_DIR}}/auto-backup"
      dockerfile: Dockerfile
    env_file:
      - "./{{CRUPEST_GENERATED_DIR}}/envs/auto-backup.env"
    volumes:
      - "./data:/data:ro"
      - "./data/auto-backup:/data/auto-backup"
    restart: "on-failure:3"

  webdav:
    image: copyparty/ac
    hostname: webdav
    volumes:
      - "./{{CRUPEST_DATA_WEBDAV_DIR}}/file:/w"
      - "./{{CRUPEST_GENERATED_DIR}}/copyparty.conf:/cfg/my.conf:ro"
      - "./{{CRUPEST_STORE_DIR}}:/w/share/store:ro"
    networks:
      default:
        ipv4_address: "172.21.5.6"
    restart: "on-failure:3"

  onebot-adapter:
    build:
      context: "."
      dockerfile: services/docker/hermes/Dockerfile
      target: adapter
      args:
        # Optional local-build apt mirror; keep APT_MIRROR empty for the
        # default Debian sources, or set it in data/config for a mirror.
        APT_MIRROR: "{{APT_MIRROR}}"
    image: crupest-onebot-adapter
    hostname: onebot-adapter
    env_file:
      - "./{{CRUPEST_GENERATED_DIR}}/envs/adapter.env"
    ports:
      - "127.0.0.1:18820:18820" # adapter WebUI (SSH tunnel only)
    volumes:
      - "./{{CRUPEST_DATA_ONEBOT_ADAPTER_DIR}}:/opt/data"
    networks:
      default:
        ipv4_address: "172.21.5.10"
    mem_limit: 800m
    restart: unless-stopped
    stop_grace_period: 30s

  hermes:
    build:
      context: "."
      dockerfile: services/docker/hermes/Dockerfile
      target: hermes
      args:
        APT_MIRROR: "{{APT_MIRROR}}"
    image: crupest-hermes
    hostname: hermes
    env_file:
      - "./{{CRUPEST_GENERATED_DIR}}/envs/hermes.env"
    volumes:
      - "./{{CRUPEST_DATA_HERMES_DIR}}:/opt/data"
      - "./{{CRUPEST_DATA_ONEBOT_ADAPTER_DIR}}/handoff:/opt/onebot-adapter:ro"
    networks:
      default:
        ipv4_address: "172.21.5.8"
    cap_drop:
      - NET_RAW
    mem_limit: 800m
    shm_size: 128m
    restart: unless-stopped
    stop_grace_period: 1m
    depends_on:
      - onebot-adapter

  napcat:
    image: mlikiowa/napcat-docker:v4.18.41
    hostname: napcat
    env_file:
      - "./{{CRUPEST_GENERATED_DIR}}/envs/napcat.env"
    ports:
      - "127.0.0.1:6099:6099" # NapCat WebUI/QR login (SSH tunnel only)
    volumes:
      - "./{{CRUPEST_DATA_NAPCAT_DIR}}/qq:/app/.config/QQ"
      - "./{{CRUPEST_DATA_NAPCAT_DIR}}/config:/app/napcat/config"
      - "./{{CRUPEST_DATA_NAPCAT_DIR}}/plugins:/app/napcat/plugins"
    networks:
      default:
        ipv4_address: "172.21.5.9"
    mem_limit: 800m
    shm_size: 256m
    restart: unless-stopped
    init: true
    depends_on:
      - onebot-adapter

volumes:
  roundcubemail-html:
  roundcubemail-temp:

networks:
  default:
    enable_ipv6: false
    ipam:
      config:
        - subnet: "172.21.5.0/24"
          ip_range: "172.21.5.64/26"
