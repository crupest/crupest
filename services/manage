#!/usr/bin/env bash

set -e

node --version >/dev/null 2>&1 || (
    echo "Error: failed to run node --version."
    echo "Install the current Node.js LTS release before continuing."
    exit 1
)

case "${BASH_SOURCE[0]}" in
    */*) script_dir="${BASH_SOURCE[0]%/*}" ;;
    *) script_dir="." ;;
esac

CRUPEST_PROJECT_DIR="$(cd -- "$script_dir/.." && pwd)"
export CRUPEST_PROJECT_DIR

echo "Detected project Dir: $CRUPEST_PROJECT_DIR"
echo

cd "$CRUPEST_PROJECT_DIR/app"

npm --version >/dev/null 2>&1 || (
    echo "Error: failed to run npm."
    echo "Install npm 11.18.0 before continuing."
    exit 1
)

exec npm run service -- --project-dir "$CRUPEST_PROJECT_DIR" "$@"
