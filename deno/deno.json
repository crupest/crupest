{
  "workspace": [
    "./base",
    "./base-contrib",
    "./gateway",
    "./mail",
    "./tools"
  ],
  "tasks": {
    "gateway:start": "deno task --cwd=gateway start",
    "mail:run": "deno task --cwd=mail run",
    "mail:serve-real": "deno task --cwd=mail serve-real",
    "build": "deno task --cwd=gateway compile && deno task --cwd=mail compile"
  },
  "imports": {
    "@hono/standard-validator": "npm:@hono/standard-validator@^0.4.0",
    "@std/collections": "jsr:@std/collections@^1.3.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/html": "jsr:@std/html@^1.0.7",
    "@std/io": "jsr:@std/io@^0.225.3",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "hono": "npm:hono@^4.13.1",
    "zod": "npm:zod@^4.4.3",
    "yargs": "npm:yargs@^18.1.0"
  },
  "exclude": ["mail/scripts/aws-lambda.js"]
}
