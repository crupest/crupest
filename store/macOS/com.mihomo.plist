<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>mihomo.metacubex.one</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/mihomo</string>
      <string>-d</string>
      <string>/usr/local/etc/mihomo</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/mihomo/stdout</string>

    <key>StandardErrorPath</key>
    <string>/var/log/mihomo/stderr</string>
  </dict>
</plist>
