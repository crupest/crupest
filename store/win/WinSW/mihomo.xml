<service>
  <id>mihomo</id>
  <name>mihomo</name>
  <description>Runs mihomo as a Windows service.</description>
  <executable>C:\Users\crupe\AppData\Local\Microsoft\WinGet\Links\mihomo-windows-amd64.exe</executable>
  <arguments>-d %BASE%</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll" />
  <onfailure action="restart" delay="0 sec" />
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="none" />
  <resetfailure>1 sec</resetfailure>
</service>
